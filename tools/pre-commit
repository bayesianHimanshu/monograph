#!/usr/bin/env bash
# Pre-commit gate: lint, types, drift, unit tests (which include the no-em-dash check). Install: make hooks.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
uv run ruff check src tests
uv run ruff format --check src tests
uv run mypy
uv run monograph check drift
uv run pytest -q
