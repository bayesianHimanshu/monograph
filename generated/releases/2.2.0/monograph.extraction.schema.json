    "ExtractedIngredient": {
      "additionalProperties": false,
      "description": "An active ingredient as stated in label narrative: name, strength and the basis of the strength.",
      "properties": {
        "basis_unit": {
          "$ref": "#/$defs/UcumUnit",
          "description": "Unit of the basis: mL in 'per 5 mL', '1' for per tablet or capsule.",
          "x-rdf-property": "https://example.org/monograph/ontology#basisUnit"
        },
        "basis_value": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "description": "Amount the strength refers to, for example 5 in 'per 5 mL'; 1 for per unit.",
          "title": "Basis Value",
          "x-rdf-property": "https://example.org/monograph/ontology#basisValue"
        },
        "strength_unit": {
          "$ref": "#/$defs/UcumUnit",
          "description": "Unit of the strength.",
          "x-rdf-property": "https://example.org/monograph/ontology#strengthUcumUnit"
        },
        "strength_value": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "description": "Numeric strength.",
          "title": "Strength Value",
          "x-rdf-property": "https://example.org/monograph/ontology#strengthValue"
        },
        "substance_name": {
          "description": "Substance name exactly as the label states it.",
          "maxLength": 500,
          "minLength": 1,
          "not": {
            "pattern": "[\u0000-\b\u000b-\f\u000e-\u001f\u007f-\u009f]"
          },
          "title": "Substance Name",
          "type": "string",
          "x-rdf-property": "https://example.org/monograph/ontology#substanceName"
        }
      },
      "required": [
        "substance_name",
        "strength_value",
        "strength_unit",
        "basis_value",
        "basis_unit"
      ],
      "title": "ExtractedIngredient",
      "type": "object"
    },
    "ExtractedPackage": {
      "additionalProperties": false,
      "description": "A package NDC mentioned in label narrative (for example in How Supplied).",
      "properties": {
        "ndc": {
          "description": "Package NDC in 4-4-2, 5-3-2 or 5-4-1 form.",
          "not": {
            "pattern": "[\u0000-\u001f\u007f-\u009f]"
          },
          "pattern": "^([0-9]{4}-[0-9]{4}-[0-9]{2}|[0-9]{5}-[0-9]{3}-[0-9]{2}|[0-9]{5}-[0-9]{4}-[0-9])$",
          "title": "Ndc",
          "type": "string",
          "x-rdf-property": "https://example.org/monograph/ontology#ndc"
        }
      },
      "required": [
        "ndc"
      ],
      "title": "ExtractedPackage",
      "type": "object"
    },
    "ExtractedProduct": {
      "additionalProperties": false,
      "description": "One product described by a label: what it is made of, its form, its routes, its packages.",
      "properties": {
        "dosage_form": {
          "$ref": "#/$defs/DosageForm",
          "description": "Dosage form.",
          "x-rdf-property": "https://example.org/monograph/ontology#extractedDosageForm"
        },
        "ingredients": {
          "description": "Active ingredients with strengths, in label order.",
          "items": {
            "$ref": "#/$defs/ExtractedIngredient"
          },
          "minItems": 1,
          "title": "Ingredients",
          "type": "array",
          "x-rdf-property": "https://example.org/monograph/ontology#extractedIngredient"
        },
        "name": {
          "description": "Product name.",
          "maxLength": 500,
          "minLength": 1,
          "not": {
            "pattern": "[\u0000-\b\u000b-\f\u000e-\u001f\u007f-\u009f]"
          },
          "title": "Name",
          "type": "string",
          "x-rdf-property": "https://example.org/monograph/ontology#name"
        },
        "packages": {
          "default": [],
          "description": "Package NDCs the label lists for this product.",
          "items": {
            "$ref": "#/$defs/ExtractedPackage"
          },
          "title": "Packages",
          "type": "array",
          "x-rdf-property": "https://example.org/monograph/ontology#extractedPackage"
        },
        "routes": {
          "description": "Routes of administration.",
          "items": {
            "$ref": "#/$defs/Route"
          },
          "minItems": 1,
          "title": "Routes",
          "type": "array",
          "uniqueItems": true,
          "x-rdf-property": "https://example.org/monograph/ontology#route"
        }
      },
      "required": [
        "name",
        "dosage_form",
        "routes",
        "ingredients"
      ],
      "title": "ExtractedProduct",
      "type": "object"
    },
    "LabelExtraction": {
      "additionalProperties": false,
      "description": "What an extractor read from one label's narrative, plus the label it came from.",
      "properties": {
        "products": {
          "description": "Products the label describes.",
          "items": {
            "$ref": "#/$defs/ExtractedProduct"
          },
          "minItems": 1,
          "title": "Products",
          "type": "array",
          "x-rdf-property": "https://example.org/monograph/ontology#extractedProduct"
        }
      },
      "required": [
        "products"
      ],
      "title": "LabelExtraction",
      "type": "object"
    },
