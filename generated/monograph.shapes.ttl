    sh:maxCount "1"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer ;
    sh:name "labeler" ;
    sh:nodeKind sh:IRI ;
    sh:not [
        sh:pattern "[\u0000-\u001F\u007F-\u009F]"
    ] ;
    sh:path mono:labeler ;
    sh:pattern "^https?://[A-Za-z0-9._~:/?#@!$&'()*+,;=%\\-]+$" .

shape:PackagedProduct-ndc
    a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:maxCount "1"^^xsd:integer ;
    sh:maxLength "12"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer ;
    sh:name "NDC" ;
    sh:not [
        sh:pattern "[\u0000-\u001F\u007F-\u009F]"
    ] ;
    sh:path mono:ndc ;
    sh:pattern "^([0-9]{4}-[0-9]{4}-[0-9]{2}|[0-9]{5}-[0-9]{3}-[0-9]{2}|[0-9]{5}-[0-9]{4}-[0-9])$" .

shape:PackagedProduct-ndc11
    a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:maxCount "1"^^xsd:integer ;
    sh:maxLength "11"^^xsd:integer ;
    sh:name "11-digit NDC" ;
    sh:not [
        sh:pattern "[\u0000-\u001F\u007F-\u009F]"
    ] ;
    sh:path mono:ndc11 ;
    sh:pattern "^[0-9]{11}$" .

shape:PackagedProduct-packageDescription
    a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:maxCount "1"^^xsd:integer ;
    sh:maxLength "2000"^^xsd:integer ;
    sh:minLength "1"^^xsd:integer ;
    sh:name "package description" ;
    sh:not [
        sh:pattern "[\u0000-\u0008\u000B-\u000C\u000E-\u001F\u007F-\u009F]"
    ] ;
    sh:path mono:packageDescription .

shape:PackagedProduct-product
    a sh:PropertyShape ;
    sh:class mono:Product ;
    sh:maxCount "1"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer ;
    sh:name "product" ;
    sh:nodeKind sh:IRI ;
    sh:not [
        sh:pattern "[\u0000-\u001F\u007F-\u009F]"
    ] ;
    sh:path mono:product ;
    sh:pattern "^https?://[A-Za-z0-9._~:/?#@!$&'()*+,;=%\\-]+$" .

shape:Product
    a sh:NodeShape ;
    rdfs:label "Product" ;
    sh:closed "true"^^xsd:boolean ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property shape:Product-clinicalDrug, shape:Product-dosageForm, shape:Product-drugMapping, shape:Product-finished, shape:Product-ingredient, shape:Product-name, shape:Product-productNdc, shape:Product-productType, shape:Product-route ;
    sh:targetClass mono:Product .

shape:Product-clinicalDrug
    a sh:PropertyShape ;
    sh:class mono:ClinicalDrug ;
    sh:maxCount "1"^^xsd:integer ;
    sh:name "clinical drug" ;
    sh:nodeKind sh:IRI ;
    sh:not [
        sh:pattern "[\u0000-\u001F\u007F-\u009F]"
    ] ;
    sh:path mono:clinicalDrug ;
    sh:pattern "^https?://[A-Za-z0-9._~:/?#@!$&'()*+,;=%\\-]+$" .

shape:Product-dosageForm
    a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:maxCount "1"^^xsd:integer ;
    sh:maxLength "100"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer ;
    sh:minLength "1"^^xsd:integer ;
    sh:name "dosage form" ;
    sh:not [
        sh:pattern "[\u0000-\u0008\u000B-\u000C\u000E-\u001F\u007F-\u009F]"
    ] ;
    sh:path mono:dosageForm .

shape:Product-drugMapping
    a sh:PropertyShape ;
    sh:class mono:DrugMapping ;
    sh:name "drug mapping" ;
    sh:node shape:DrugMapping ;
    sh:nodeKind sh:IRI ;
    sh:path mono:drugMapping .

shape:Product-finished
    a sh:PropertyShape ;
    sh:datatype xsd:boolean ;
    sh:maxCount "1"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer ;
    sh:name "finished" ;
    sh:path mono:finished .

shape:Product-ingredient
    a sh:PropertyShape ;
    sh:class mono:Ingredient ;
    sh:name "ingredient" ;
    sh:node shape:Ingredient ;
    sh:nodeKind sh:IRI ;
    sh:path mono:ingredient .

shape:Product-name
    a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:maxCount "1"^^xsd:integer ;
    sh:maxLength "500"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer ;
    sh:minLength "1"^^xsd:integer ;
    sh:name "name" ;
    sh:not [
        sh:pattern "[\u0000-\u0008\u000B-\u000C\u000E-\u001F\u007F-\u009F]"
    ] ;
    sh:path mono:name .

shape:Product-productNdc
    a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:maxCount "1"^^xsd:integer ;
    sh:maxLength "10"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer ;
    sh:name "product NDC" ;
    sh:not [
        sh:pattern "[\u0000-\u001F\u007F-\u009F]"
    ] ;
    sh:path mono:productNdc ;
    sh:pattern "^([0-9]{4}-[0-9]{4}|[0-9]{5}-[0-9]{3}|[0-9]{5}-[0-9]{4})$" .

shape:Product-productType
    a sh:PropertyShape ;
    sh:in ( mono:ProductType-HUMAN_PRESCRIPTION_DRUG mono:ProductType-HUMAN_OTC_DRUG mono:ProductType-PLASMA_DERIVATIVE mono:ProductType-CELLULAR_THERAPY mono:ProductType-VACCINE mono:ProductType-STANDARDIZED_ALLERGENIC mono:ProductType-NON_STANDARDIZED_ALLERGENIC mono:ProductType-BULK_INGREDIENT mono:ProductType-DRUG_FOR_FURTHER_PROCESSING mono:ProductType-LICENSED_VACCINE_BULK_INTERMEDIATE ) ;
    sh:maxCount "1"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer ;
    sh:name "product type" ;
    sh:path mono:productType .

shape:Product-route
    a sh:PropertyShape ;
    sh:in ( mono:Route-AURICULAR_OTIC mono:Route-BUCCAL mono:Route-CONJUNCTIVAL mono:Route-CUTANEOUS mono:Route-DENTAL mono:Route-ELECTRO_OSMOSIS mono:Route-ENDOCERVICAL mono:Route-ENDOSINUSIAL mono:Route-ENDOTRACHEAL mono:Route-ENTERAL mono:Route-EPIDURAL mono:Route-EXTRA_AMNIOTIC mono:Route-EXTRACORPOREAL mono:Route-HEMODIALYSIS mono:Route-INFILTRATION mono:Route-INTERSTITIAL mono:Route-INTRA_ABDOMINAL mono:Route-INTRA_AMNIOTIC mono:Route-INTRA_ARTERIAL mono:Route-INTRA_ARTICULAR mono:Route-INTRABILIARY mono:Route-INTRABRONCHIAL mono:Route-INTRABURSAL mono:Route-INTRACAMERAL mono:Route-INTRACANALICULAR mono:Route-INTRACARDIAC mono:Route-INTRACARTILAGINOUS mono:Route-INTRACAUDAL mono:Route-INTRACAVERNOUS mono:Route-INTRACAVITARY mono:Route-INTRACEREBRAL mono:Route-INTRACISTERNAL mono:Route-INTRACORNEAL mono:Route-INTRACORONAL_DENTAL mono:Route-INTRACORONARY mono:Route-INTRACORPORUS_CAVERNOSUM mono:Route-INTRACRANIAL mono:Route-INTRADERMAL mono:Route-INTRADISCAL mono:Route-INTRADUCTAL mono:Route-INTRADUODENAL mono:Route-INTRADURAL mono:Route-INTRAEPICARDIAL mono:Route-INTRAEPIDERMAL mono:Route-INTRAESOPHAGEAL mono:Route-INTRAGASTRIC mono:Route-INTRAGINGIVAL mono:Route-INTRAHEPATIC mono:Route-INTRAILEAL mono:Route-INTRALESIONAL mono:Route-INTRALINGUAL mono:Route-INTRALUMINAL mono:Route-INTRALYMPHATIC mono:Route-INTRAMAMMARY mono:Route-INTRAMEDULLARY mono:Route-INTRAMENINGEAL mono:Route-INTRAMUSCULAR mono:Route-INTRANODAL mono:Route-INTRAOCULAR mono:Route-INTRAOMENTUM mono:Route-INTRAOVARIAN mono:Route-INTRAPERICARDIAL mono:Route-INTRAPERITONEAL mono:Route-INTRAPLEURAL mono:Route-INTRAPROSTATIC mono:Route-INTRAPULMONARY mono:Route-INTRARUMINAL mono:Route-INTRASINAL mono:Route-INTRASPINAL mono:Route-INTRASYNOVIAL mono:Route-INTRATENDINOUS mono:Route-INTRATESTICULAR mono:Route-INTRATHECAL mono:Route-INTRATHORACIC mono:Route-INTRATUBULAR mono:Route-INTRATUMOR mono:Route-INTRATYMPANIC mono:Route-INTRAUTERINE mono:Route-INTRAVASCULAR mono:Route-INTRAVENOUS mono:Route-INTRAVENTRICULAR mono:Route-INTRAVESICAL mono:Route-INTRAVITREAL mono:Route-IONTOPHORESIS mono:Route-IRRIGATION mono:Route-LARYNGEAL mono:Route-NASAL mono:Route-NASOGASTRIC mono:Route-NOT_APPLICABLE mono:Route-OCCLUSIVE_DRESSING_TECHNIQUE mono:Route-OPHTHALMIC mono:Route-ORAL mono:Route-OROPHARYNGEAL mono:Route-PARENTERAL mono:Route-PERCUTANEOUS mono:Route-PERIARTICULAR mono:Route-PERIDURAL mono:Route-PERINEURAL mono:Route-PERIODONTAL mono:Route-RECTAL mono:Route-RESPIRATORY_INHALATION mono:Route-RETROBULBAR mono:Route-SOFT_TISSUE mono:Route-SUBARACHNOID mono:Route-SUBCONJUNCTIVAL mono:Route-SUBCUTANEOUS mono:Route-SUBGINGIVAL mono:Route-SUBLINGUAL mono:Route-SUBMUCOSAL mono:Route-SUBRETINAL mono:Route-SUPRACHOROIDAL mono:Route-TOPICAL mono:Route-TRANSDERMAL mono:Route-TRANSENDOCARDIAL mono:Route-TRANSMUCOSAL mono:Route-TRANSPLACENTAL mono:Route-TRANSTRACHEAL mono:Route-TRANSTYMPANIC mono:Route-URETERAL mono:Route-URETHRAL mono:Route-VAGINAL ) ;
    sh:name "route" ;
    sh:path mono:route .

shape:Reaction
    a sh:NodeShape ;
    rdfs:label "Reaction" ;
    sh:closed "true"^^xsd:boolean ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property shape:Reaction-meddraPreferredTerm ;
    sh:targetClass mono:Reaction .

shape:Reaction-meddraPreferredTerm
    a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:maxCount "1"^^xsd:integer ;
    sh:maxLength "100"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer ;
    sh:minLength "1"^^xsd:integer ;
    sh:name "MedDRA preferred term" ;
    sh:not [
        sh:pattern "[\u0000-\u0008\u000B-\u000C\u000E-\u001F\u007F-\u009F]"
    ] ;
    sh:path mono:meddraPreferredTerm .

shape:Recall
    a sh:NodeShape ;
    rdfs:label "Recall" ;
    sh:closed "true"^^xsd:boolean ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property shape:Recall-recallClassification, shape:Recall-recallNumber, shape:Recall-recallReason, shape:Recall-recallingFirm, shape:Recall-recallsProduct, shape:Recall-reportDate ;
    sh:targetClass mono:Recall .

shape:Recall-recallClassification
    a sh:PropertyShape ;
    sh:in ( mono:RecallClassification-CLASS_I mono:RecallClassification-CLASS_II mono:RecallClassification-CLASS_III ) ;
    sh:maxCount "1"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer ;
    sh:name "classification" ;
    sh:path mono:recallClassification .

shape:Recall-recallNumber
    a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:maxCount "1"^^xsd:integer ;
    sh:maxLength "11"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer ;
    sh:name "recall number" ;
    sh:not [
        sh:pattern "[\u0000-\u001F\u007F-\u009F]"
    ] ;
    sh:path mono:recallNumber ;
    sh:pattern "^D-[0-9]{3,4}-[0-9]{4}$" .

shape:Recall-recallReason
    a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:maxCount "1"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer ;
    sh:minLength "1"^^xsd:integer ;
    sh:name "reason" ;
    sh:not [
        sh:pattern "[\u0000-\u0008\u000B-\u000C\u000E-\u001F\u007F-\u009F]"
    ] ;
    sh:path mono:recallReason .

shape:Recall-recallingFirm
    a sh:PropertyShape ;
    sh:class mono:Organization ;
    sh:maxCount "1"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer ;
    sh:name "recalling firm" ;
    sh:nodeKind sh:IRI ;
    sh:not [
        sh:pattern "[\u0000-\u001F\u007F-\u009F]"
    ] ;
    sh:path mono:recallingFirm ;
    sh:pattern "^https?://[A-Za-z0-9._~:/?#@!$&'()*+,;=%\\-]+$" .

shape:Recall-recallsProduct
    a sh:PropertyShape ;
    sh:class mono:Product ;
    sh:name "recalls product" ;
    sh:nodeKind sh:IRI ;
    sh:not [
        sh:pattern "[\u0000-\u001F\u007F-\u009F]"
    ] ;
    sh:path mono:recallsProduct ;
    sh:pattern "^https?://[A-Za-z0-9._~:/?#@!$&'()*+,;=%\\-]+$" .

shape:Recall-reportDate
    a sh:PropertyShape ;
    sh:datatype xsd:date ;
    sh:maxCount "1"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer ;
    sh:name "report date" ;
    sh:path mono:reportDate .

shape:Substance
    a sh:NodeShape ;
    rdfs:label "Substance" ;
    sh:closed "true"^^xsd:boolean ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property shape:Substance-hasActiveMoiety, shape:Substance-name, shape:Substance-unii ;
    sh:targetClass mono:Substance .

shape:Substance-hasActiveMoiety
    a sh:PropertyShape ;
    sh:class mono:MoietyLink ;
    sh:maxCount "1"^^xsd:integer ;
    sh:name "has active moiety" ;
    sh:node shape:MoietyLink ;
    sh:nodeKind sh:IRI ;
    sh:path mono:hasActiveMoiety .

shape:Substance-name
    a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:maxCount "1"^^xsd:integer ;
    sh:maxLength "500"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer ;
    sh:minLength "1"^^xsd:integer ;
    sh:name "name" ;
    sh:not [
        sh:pattern "[\u0000-\u0008\u000B-\u000C\u000E-\u001F\u007F-\u009F]"
    ] ;
    sh:path mono:name .

shape:Substance-unii
    a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:maxCount "1"^^xsd:integer ;
    sh:maxLength "10"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer ;
    sh:name "UNII" ;
    sh:not [
        sh:pattern "[\u0000-\u001F\u007F-\u009F]"
    ] ;
    sh:path mono:unii ;
    sh:pattern "^[0-9A-Z]{10}$" .

shape:rule-finished-rx-otc-requires-route
    a sh:NodeShape ;
    rdfs:label "finished-rx-otc-requires-route" ;
    sh:message "a finished prescription or OTC product needs at least one route" ;
    sh:or ( [
        sh:not [
            sh:hasValue "true"^^xsd:boolean ;
            sh:path mono:finished
        ]
    ] [
        sh:not [
            sh:in ( mono:ProductType-HUMAN_PRESCRIPTION_DRUG mono:ProductType-HUMAN_OTC_DRUG ) ;
            sh:minCount "1"^^xsd:integer ;
            sh:path mono:productType
        ]
    ] [
        sh:minCount "1"^^xsd:integer ;
        sh:path mono:route
    ] ) ;
    sh:targetClass mono:Product .

shape:rule-has-suspect
    a sh:NodeShape ;
    rdfs:label "has-suspect" ;
    sh:message "a report needs at least one suspect drug (primary, secondary or unspecified)" ;
    sh:property [
        sh:path mono:drugInvolvement ;
        sh:qualifiedMinCount "1"^^xsd:integer ;
        sh:qualifiedValueShape [
            sh:property [
                sh:in ( mono:DrugRole-PRIMARY_SUSPECT mono:DrugRole-SECONDARY_SUSPECT mono:DrugRole-SUSPECT ) ;
                sh:minCount "1"^^xsd:integer ;
                sh:path mono:drugRole
            ]
        ]
    ] ;
    sh:targetClass mono:AdverseEventReport .

shape:rule-listed-package-resolves
    a sh:NodeShape ;
    rdfs:label "listed-package-resolves" ;
    sh:message "the registry lists this label's products, so the NDC must be one of their packages" ;
    sh:or ( [
        sh:not [
            sh:hasValue "true"^^xsd:boolean ;
            sh:path mono:registryListsProduct
        ]
    ] [
        sh:minCount "1"^^xsd:integer ;
        sh:path mono:resolvedPackage
    ] ) ;
    sh:targetClass mono:ExtractedPackage .

shape:rule-serious-requires-criterion
    a sh:NodeShape ;
    rdfs:label "serious-requires-criterion" ;
    sh:message "a serious report needs at least one seriousness criterion" ;
    sh:or ( [
        sh:not [
            sh:hasValue "true"^^xsd:boolean ;
            sh:path mono:serious
        ]
    ] [
        sh:minCount "1"^^xsd:integer ;
        sh:path mono:seriousnessCriterion
    ] ) ;
    sh:targetClass mono:AdverseEventReport .
