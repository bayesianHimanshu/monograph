@prefix mono: <https://example.org/monograph/ontology#> .
@prefix shape: <https://example.org/monograph/shapes#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

shape:AdverseEventReport
    a sh:NodeShape ;
    rdfs:label "Adverse event report" ;
    sh:closed "true"^^xsd:boolean ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property shape:AdverseEventReport-drugInvolvement, shape:AdverseEventReport-patientAgeYears, shape:AdverseEventReport-reaction, shape:AdverseEventReport-receiptDate, shape:AdverseEventReport-safetyReportId, shape:AdverseEventReport-serious, shape:AdverseEventReport-seriousnessCriterion, shape:AdverseEventReport-sourceSystem ;
    sh:targetClass mono:AdverseEventReport .

shape:AdverseEventReport-drugInvolvement
    a sh:PropertyShape ;
    sh:class mono:DrugInvolvement ;
    sh:minCount "1"^^xsd:integer ;
    sh:name "drug involvement" ;
    sh:node shape:DrugInvolvement ;
    sh:nodeKind sh:IRI ;
    sh:path mono:drugInvolvement .

shape:AdverseEventReport-patientAgeYears
    a sh:PropertyShape ;
    sh:datatype xsd:decimal ;
    sh:maxCount "1"^^xsd:integer ;
    sh:maxInclusive "150"^^xsd:decimal ;
    sh:minInclusive "0"^^xsd:decimal ;
    sh:name "patient age in years" ;
    sh:path mono:patientAgeYears .

shape:AdverseEventReport-reaction
    a sh:PropertyShape ;
    sh:class mono:Reaction ;
    sh:minCount "1"^^xsd:integer ;
    sh:name "reaction" ;
    sh:node shape:Reaction ;
    sh:nodeKind sh:IRI ;
    sh:path mono:reaction .

shape:AdverseEventReport-receiptDate
    a sh:PropertyShape ;
    sh:datatype xsd:date ;
    sh:maxCount "1"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer ;
    sh:name "receipt date" ;
    sh:path mono:receiptDate .

shape:AdverseEventReport-safetyReportId
    a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:maxCount "1"^^xsd:integer ;
    sh:maxLength "16"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer ;
    sh:name "safety report ID" ;
    sh:not [
        sh:pattern "[\u0000-\u001F\u007F-\u009F]"
    ] ;
    sh:path mono:safetyReportId ;
    sh:pattern "^[0-9]{1,12}(-[0-9]{1,3})?$" .

shape:AdverseEventReport-serious
    a sh:PropertyShape ;
    sh:datatype xsd:boolean ;
    sh:maxCount "1"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer ;
    sh:name "serious" ;
    sh:path mono:serious .

shape:AdverseEventReport-seriousnessCriterion
    a sh:PropertyShape ;
    sh:in ( mono:SeriousnessCriterion-DEATH mono:SeriousnessCriterion-LIFE_THREATENING mono:SeriousnessCriterion-HOSPITALIZATION mono:SeriousnessCriterion-DISABLING mono:SeriousnessCriterion-CONGENITAL_ANOMALY mono:SeriousnessCriterion-OTHER ) ;
    sh:maxCount "6"^^xsd:integer ;
    sh:name "seriousness criterion" ;
    sh:path mono:seriousnessCriterion .

shape:AdverseEventReport-sourceSystem
    a sh:PropertyShape ;
    sh:in ( mono:SourceSystem-OPENFDA_E2B mono:SourceSystem-FAERS_QDE ) ;
    sh:maxCount "1"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer ;
    sh:name "source system" ;
    sh:path mono:sourceSystem .

shape:ClinicalDrug
    a sh:NodeShape ;
    rdfs:label "Clinical drug" ;
    sh:closed "true"^^xsd:boolean ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property shape:ClinicalDrug-hasGeneric, shape:ClinicalDrug-name, shape:ClinicalDrug-rxcui, shape:ClinicalDrug-termType ;
    sh:targetClass mono:ClinicalDrug .

shape:ClinicalDrug-hasGeneric
    a sh:PropertyShape ;
    sh:class mono:GenericLink ;
    sh:maxCount "1"^^xsd:integer ;
    sh:name "has generic" ;
    sh:node shape:GenericLink ;
    sh:nodeKind sh:IRI ;
    sh:path mono:hasGeneric .

shape:ClinicalDrug-name
    a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:maxCount "1"^^xsd:integer ;
    sh:maxLength "500"^^xsd:integer ;
    sh:minLength "1"^^xsd:integer ;
    sh:name "name" ;
    sh:not [
        sh:pattern "[\u0000-\u0008\u000B-\u000C\u000E-\u001F\u007F-\u009F]"
    ] ;
    sh:path mono:name .

shape:ClinicalDrug-rxcui
    a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:maxCount "1"^^xsd:integer ;
    sh:maxLength "8"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer ;
    sh:name "RxCUI" ;
    sh:not [
        sh:pattern "[\u0000-\u001F\u007F-\u009F]"
    ] ;
    sh:path mono:rxcui ;
    sh:pattern "^[0-9]{1,8}$" .

shape:ClinicalDrug-termType
    a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:maxCount "1"^^xsd:integer ;
    sh:maxLength "6"^^xsd:integer ;
    sh:name "RxNorm term type" ;
    sh:not [
        sh:pattern "[\u0000-\u001F\u007F-\u009F]"
    ] ;
    sh:path mono:termType ;
    sh:pattern "^[A-Z]{2,6}$" .

shape:DrugInvolvement
    a sh:NodeShape ;
    rdfs:label "Drug involvement" ;
    sh:closed "true"^^xsd:boolean ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property shape:DrugInvolvement-clinicalDrug, shape:DrugInvolvement-drugRole, shape:DrugInvolvement-harmonizedClinicalDrug, shape:DrugInvolvement-verbatimDrugName ;
    sh:targetClass mono:DrugInvolvement .

shape:DrugInvolvement-clinicalDrug
    a sh:PropertyShape ;
    sh:class mono:ClinicalDrug ;
    sh:maxCount "1"^^xsd:integer ;
    sh:name "clinical drug" ;
    sh:nodeKind sh:IRI ;
    sh:not [
        sh:pattern "[\u0000-\u001F\u007F-\u009F]"
    ] ;
    sh:path mono:clinicalDrug ;
    sh:pattern "^https?://[A-Za-z0-9._~:/?#@!$&'()*+,;=%\\-]+$" .

shape:DrugInvolvement-drugRole
    a sh:PropertyShape ;
    sh:in ( mono:DrugRole-PRIMARY_SUSPECT mono:DrugRole-SECONDARY_SUSPECT mono:DrugRole-SUSPECT mono:DrugRole-CONCOMITANT mono:DrugRole-INTERACTING ) ;
    sh:maxCount "1"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer ;
    sh:name "drug role" ;
    sh:path mono:drugRole .

shape:DrugInvolvement-harmonizedClinicalDrug
    a sh:PropertyShape ;
    sh:class mono:ClinicalDrug ;
    sh:name "harmonized clinical drug" ;
    sh:nodeKind sh:IRI ;
    sh:not [
        sh:pattern "[\u0000-\u001F\u007F-\u009F]"
    ] ;
    sh:path mono:harmonizedClinicalDrug ;
    sh:pattern "^https?://[A-Za-z0-9._~:/?#@!$&'()*+,;=%\\-]+$" .

shape:DrugInvolvement-verbatimDrugName
    a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:maxCount "1"^^xsd:integer ;
    sh:maxLength "500"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer ;
    sh:minLength "1"^^xsd:integer ;
    sh:name "verbatim drug name" ;
    sh:not [
        sh:pattern "[\u0000-\u0008\u000B-\u000C\u000E-\u001F\u007F-\u009F]"
    ] ;
    sh:path mono:verbatimDrugName .

shape:DrugMapping
    a sh:NodeShape ;
    rdfs:label "Drug mapping" ;
    sh:closed "true"^^xsd:boolean ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property shape:DrugMapping-evidence, shape:DrugMapping-mappedClinicalDrug, shape:DrugMapping-mappingSource ;
    sh:targetClass mono:DrugMapping .

shape:DrugMapping-evidence
    a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:maxCount "1"^^xsd:integer ;
    sh:maxLength "500"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer ;
    sh:minLength "1"^^xsd:integer ;
    sh:name "evidence" ;
    sh:not [
        sh:pattern "[\u0000-\u0008\u000B-\u000C\u000E-\u001F\u007F-\u009F]"
    ] ;
    sh:path mono:evidence .

shape:DrugMapping-mappedClinicalDrug
    a sh:PropertyShape ;
    sh:class mono:ClinicalDrug ;
    sh:maxCount "1"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer ;
    sh:name "mapped clinical drug" ;
    sh:nodeKind sh:IRI ;
    sh:not [
        sh:pattern "[\u0000-\u001F\u007F-\u009F]"
    ] ;
    sh:path mono:mappedClinicalDrug ;
    sh:pattern "^https?://[A-Za-z0-9._~:/?#@!$&'()*+,;=%\\-]+$" .

shape:DrugMapping-mappingSource
    a sh:PropertyShape ;
    sh:in ( mono:MappingSource-OPENFDA_NDC mono:MappingSource-RXNAV_NDCPROPERTIES ) ;
    sh:maxCount "1"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer ;
    sh:name "mapping source" ;
    sh:path mono:mappingSource .

shape:EmbeddedValue
    a sh:NodeShape ;
    rdfs:label "Embedded value" ;
    sh:targetClass mono:EmbeddedValue .

shape:Entity
    a sh:NodeShape ;
    rdfs:label "Entity" ;
    sh:targetClass mono:Entity .

shape:ExtractedIngredient
    a sh:NodeShape ;
    rdfs:label "Extracted ingredient" ;
    sh:closed "true"^^xsd:boolean ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property shape:ExtractedIngredient-basisUnit, shape:ExtractedIngredient-basisValue, shape:ExtractedIngredient-resolvedSubstance, shape:ExtractedIngredient-strengthUcumUnit, shape:ExtractedIngredient-strengthValue, shape:ExtractedIngredient-substanceName ;
    sh:targetClass mono:ExtractedIngredient .

shape:ExtractedIngredient-basisUnit
    a sh:PropertyShape ;
    sh:in ( mono:UcumUnit-UNIT_OF_PRESENTATION mono:UcumUnit-ALLERGY_UNITS mono:UcumUnit-AMB_A_1_UNITS mono:UcumUnit-BIOEQUIVALENT_ALLERGY_UNITS mono:UcumUnit-ARBITRARY_UNITS mono:UcumUnit-CELL_CULTURE_INFECTIOUS_DOSE_50 mono:UcumUnit-COLONY_FORMING_UNITS mono:UcumUnit-CURIE mono:UcumUnit-DAY mono:UcumUnit-D_ANTIGEN_UNITS mono:UcumUnit-DECILITER mono:UcumUnit-FOCUS_FORMING_UNITS mono:UcumUnit-FORMAZIN_TURBIDITY_UNIT mono:UcumUnit-GENOMIC_COPIES mono:UcumUnit-GRAM mono:UcumUnit-HOMEOPATHIC_POTENCY_OF_CENTESIMAL_SERIES mono:UcumUnit-HOMEOPATHIC_POTENCY_OF_CENTESIMAL_KORSAKOVIAN_SERIES mono:UcumUnit-HOMEOPATHIC_POTENCY_OF_MILLESIMAL_SERIES mono:UcumUnit-HOMEOPATHIC_POTENCY_OF_QUINTAMILLESIMAL_SERIES mono:UcumUnit-HOMEOPATHIC_POTENCY_OF_DECIMAL_SERIES mono:UcumUnit-HOUR mono:UcumUnit-INTERNATIONAL_UNITS mono:UcumUnit-KILOGRAM mono:UcumUnit-LIMIT_OF_FLOCCULATION mono:UcumUnit-LITER mono:UcumUnit-MICROCURIE mono:UcumUnit-MICROGRAM mono:UcumUnit-MICROLITER mono:UcumUnit-MICROMOLE mono:UcumUnit-MICRON mono:UcumUnit-MILLICURIE mono:UcumUnit-MILLIEQUIVALENT mono:UcumUnit-MILLIGRAM mono:UcumUnit-MILLILITER mono:UcumUnit-MILLIMETER mono:UcumUnit-MILLIMOLE mono:UcumUnit-MINUTE mono:UcumUnit-MOLE mono:UcumUnit-MONTH mono:UcumUnit-NANOGRAM mono:UcumUnit-NANOMOLE mono:UcumUnit-NEPHELOMETRIC_TURBIDITY_UNIT mono:UcumUnit-PLAQUE_FORMING_UNITS mono:UcumUnit-PROTEIN_NITROGEN_UNITS mono:UcumUnit-SECOND mono:UcumUnit-SQUARE_CENTIMETER mono:UcumUnit-TISSUE_CULTURE_INFECTIOUS_DOSE_50 mono:UcumUnit-UNIT_CATALYTIC_ACTIVITY mono:UcumUnit-UNITED_STATES_PHARMACOPEIA_UNIT mono:UcumUnit-VIRAL_PARTICLES mono:UcumUnit-WEEK mono:UcumUnit-YEAR ) ;
    sh:maxCount "1"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer ;
    sh:name "basis unit (UCUM)" ;
    sh:path mono:basisUnit .

shape:ExtractedIngredient-basisValue
    a sh:PropertyShape ;
    sh:datatype xsd:decimal ;
    sh:maxCount "1"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer ;
    sh:minExclusive "0"^^xsd:decimal ;
    sh:name "basis value" ;
    sh:path mono:basisValue .

shape:ExtractedIngredient-resolvedSubstance
    a sh:PropertyShape ;
    sh:class mono:Substance ;
    sh:maxCount "1"^^xsd:integer ;
    sh:name "resolved substance" ;
    sh:nodeKind sh:IRI ;
    sh:not [
        sh:pattern "[\u0000-\u001F\u007F-\u009F]"
    ] ;
    sh:path mono:resolvedSubstance ;
    sh:pattern "^https?://[A-Za-z0-9._~:/?#@!$&'()*+,;=%\\-]+$" .

shape:ExtractedIngredient-strengthUcumUnit
    a sh:PropertyShape ;
    sh:in ( mono:UcumUnit-UNIT_OF_PRESENTATION mono:UcumUnit-ALLERGY_UNITS mono:UcumUnit-AMB_A_1_UNITS mono:UcumUnit-BIOEQUIVALENT_ALLERGY_UNITS mono:UcumUnit-ARBITRARY_UNITS mono:UcumUnit-CELL_CULTURE_INFECTIOUS_DOSE_50 mono:UcumUnit-COLONY_FORMING_UNITS mono:UcumUnit-CURIE mono:UcumUnit-DAY mono:UcumUnit-D_ANTIGEN_UNITS mono:UcumUnit-DECILITER mono:UcumUnit-FOCUS_FORMING_UNITS mono:UcumUnit-FORMAZIN_TURBIDITY_UNIT mono:UcumUnit-GENOMIC_COPIES mono:UcumUnit-GRAM mono:UcumUnit-HOMEOPATHIC_POTENCY_OF_CENTESIMAL_SERIES mono:UcumUnit-HOMEOPATHIC_POTENCY_OF_CENTESIMAL_KORSAKOVIAN_SERIES mono:UcumUnit-HOMEOPATHIC_POTENCY_OF_MILLESIMAL_SERIES mono:UcumUnit-HOMEOPATHIC_POTENCY_OF_QUINTAMILLESIMAL_SERIES mono:UcumUnit-HOMEOPATHIC_POTENCY_OF_DECIMAL_SERIES mono:UcumUnit-HOUR mono:UcumUnit-INTERNATIONAL_UNITS mono:UcumUnit-KILOGRAM mono:UcumUnit-LIMIT_OF_FLOCCULATION mono:UcumUnit-LITER mono:UcumUnit-MICROCURIE mono:UcumUnit-MICROGRAM mono:UcumUnit-MICROLITER mono:UcumUnit-MICROMOLE mono:UcumUnit-MICRON mono:UcumUnit-MILLICURIE mono:UcumUnit-MILLIEQUIVALENT mono:UcumUnit-MILLIGRAM mono:UcumUnit-MILLILITER mono:UcumUnit-MILLIMETER mono:UcumUnit-MILLIMOLE mono:UcumUnit-MINUTE mono:UcumUnit-MOLE mono:UcumUnit-MONTH mono:UcumUnit-NANOGRAM mono:UcumUnit-NANOMOLE mono:UcumUnit-NEPHELOMETRIC_TURBIDITY_UNIT mono:UcumUnit-PLAQUE_FORMING_UNITS mono:UcumUnit-PROTEIN_NITROGEN_UNITS mono:UcumUnit-SECOND mono:UcumUnit-SQUARE_CENTIMETER mono:UcumUnit-TISSUE_CULTURE_INFECTIOUS_DOSE_50 mono:UcumUnit-UNIT_CATALYTIC_ACTIVITY mono:UcumUnit-UNITED_STATES_PHARMACOPEIA_UNIT mono:UcumUnit-VIRAL_PARTICLES mono:UcumUnit-WEEK mono:UcumUnit-YEAR ) ;
    sh:maxCount "1"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer ;
    sh:name "strength unit (UCUM)" ;
    sh:path mono:strengthUcumUnit .

shape:ExtractedIngredient-strengthValue
    a sh:PropertyShape ;
    sh:datatype xsd:decimal ;
    sh:maxCount "1"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer ;
    sh:minExclusive "0"^^xsd:decimal ;
    sh:name "strength value" ;
    sh:path mono:strengthValue .

shape:ExtractedIngredient-substanceName
    a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:maxCount "1"^^xsd:integer ;
    sh:maxLength "500"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer ;
    sh:minLength "1"^^xsd:integer ;
    sh:name "substance name" ;
    sh:not [
        sh:pattern "[\u0000-\u0008\u000B-\u000C\u000E-\u001F\u007F-\u009F]"
    ] ;
    sh:path mono:substanceName .

shape:ExtractedPackage
    a sh:NodeShape ;
    rdfs:label "Extracted package" ;
    sh:closed "true"^^xsd:boolean ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property shape:ExtractedPackage-ndc, shape:ExtractedPackage-registryListsProduct, shape:ExtractedPackage-resolvedPackage ;
    sh:targetClass mono:ExtractedPackage .

shape:ExtractedPackage-ndc
    a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:maxCount "1"^^xsd:integer ;
    sh:maxLength "12"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer ;
    sh:name "NDC" ;
    sh:not [
        sh:pattern "[\u0000-\u001F\u007F-\u009F]"
    ] ;
    sh:path mono:ndc ;
    sh:pattern "^([0-9]{4}-[0-9]{4}-[0-9]{2}|[0-9]{5}-[0-9]{3}-[0-9]{2}|[0-9]{5}-[0-9]{4}-[0-9])$" .

shape:ExtractedPackage-registryListsProduct
    a sh:PropertyShape ;
    sh:datatype xsd:boolean ;
    sh:maxCount "1"^^xsd:integer ;
    sh:name "registry lists the label's products" ;
    sh:path mono:registryListsProduct .

shape:ExtractedPackage-resolvedPackage
    a sh:PropertyShape ;
    sh:class mono:PackagedProduct ;
    sh:maxCount "1"^^xsd:integer ;
    sh:name "resolved package" ;
    sh:nodeKind sh:IRI ;
    sh:not [
        sh:pattern "[\u0000-\u001F\u007F-\u009F]"
    ] ;
    sh:path mono:resolvedPackage ;
    sh:pattern "^https?://[A-Za-z0-9._~:/?#@!$&'()*+,;=%\\-]+$" .

shape:ExtractedProduct
    a sh:NodeShape ;
    rdfs:label "Extracted product" ;
    sh:closed "true"^^xsd:boolean ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property shape:ExtractedProduct-extractedDosageForm, shape:ExtractedProduct-extractedIngredient, shape:ExtractedProduct-extractedPackage, shape:ExtractedProduct-name, shape:ExtractedProduct-route ;
    sh:targetClass mono:ExtractedProduct .

shape:ExtractedProduct-extractedDosageForm
    a sh:PropertyShape ;
    sh:in ( mono:DosageForm-AEROSOL mono:DosageForm-AEROSOL_FOAM mono:DosageForm-AEROSOL_METERED mono:DosageForm-AEROSOL_POWDER mono:DosageForm-AEROSOL_SPRAY mono:DosageForm-BAR_CHEWABLE mono:DosageForm-BEAD mono:DosageForm-CAPSULE mono:DosageForm-CAPSULE_COATED mono:DosageForm-CAPSULE_COATED_PELLETS mono:DosageForm-CAPSULE_COATED_EXTENDED_RELEASE mono:DosageForm-CAPSULE_DELAYED_RELEASE mono:DosageForm-CAPSULE_DELAYED_RELEASE_PELLETS mono:DosageForm-CAPSULE_EXTENDED_RELEASE mono:DosageForm-CAPSULE_FILM_COATED_EXTENDED_RELEASE mono:DosageForm-CAPSULE_GELATIN_COATED mono:DosageForm-CAPSULE_LIQUID_FILLED mono:DosageForm-CELLULAR_SHEET mono:DosageForm-CHEWABLE_GEL mono:DosageForm-CLOTH mono:DosageForm-CONCENTRATE mono:DosageForm-CREAM mono:DosageForm-CREAM_AUGMENTED mono:DosageForm-CRYSTAL mono:DosageForm-DISC mono:DosageForm-DOUCHE mono:DosageForm-DRESSING mono:DosageForm-DRUG_ELUTING_CONTACT_LENS mono:DosageForm-ELIXIR mono:DosageForm-EMULSION mono:DosageForm-ENEMA mono:DosageForm-EXTRACT mono:DosageForm-FIBER_EXTENDED_RELEASE mono:DosageForm-FILM mono:DosageForm-FILM_EXTENDED_RELEASE mono:DosageForm-FILM_SOLUBLE mono:DosageForm-FOR_SOLUTION mono:DosageForm-FOR_SUSPENSION mono:DosageForm-FOR_SUSPENSION_EXTENDED_RELEASE mono:DosageForm-GAS mono:DosageForm-GEL mono:DosageForm-GEL_DENTIFRICE mono:DosageForm-GEL_METERED mono:DosageForm-GLOBULE mono:DosageForm-GRANULE mono:DosageForm-GRANULE_DELAYED_RELEASE mono:DosageForm-GRANULE_EFFERVESCENT mono:DosageForm-GRANULE_FOR_SOLUTION mono:DosageForm-GRANULE_FOR_SUSPENSION mono:DosageForm-GRANULE_FOR_SUSPENSION_EXTENDED_RELEASE mono:DosageForm-GUM_CHEWING mono:DosageForm-IMPLANT mono:DosageForm-INHALANT mono:DosageForm-INJECTABLE_FOAM mono:DosageForm-INJECTABLE_LIPOSOMAL mono:DosageForm-INJECTION mono:DosageForm-INJECTION_EMULSION mono:DosageForm-INJECTION_LIPID_COMPLEX mono:DosageForm-INJECTION_POWDER_FOR_SOLUTION mono:DosageForm-INJECTION_POWDER_FOR_SUSPENSION mono:DosageForm-INJECTION_POWDER_FOR_SUSPENSION_EXTENDED_RELEASE mono:DosageForm-INJECTION_POWDER_LYOPHILIZED_FOR_LIPOSOMAL_SUSPENSION mono:DosageForm-INJECTION_POWDER_LYOPHILIZED_FOR_SOLUTION mono:DosageForm-INJECTION_POWDER_LYOPHILIZED_FOR_SUSPENSION mono:DosageForm-INJECTION_POWDER_LYOPHILIZED_FOR_SUSPENSION_EXTENDED_RELEASE mono:DosageForm-INJECTION_SOLUTION mono:DosageForm-INJECTION_SOLUTION_CONCENTRATE mono:DosageForm-INJECTION_SUSPENSION mono:DosageForm-INJECTION_SUSPENSION_EXTENDED_RELEASE mono:DosageForm-INJECTION_SUSPENSION_LIPOSOMAL mono:DosageForm-INJECTION_SUSPENSION_SONICATED mono:DosageForm-INSERT mono:DosageForm-INSERT_EXTENDED_RELEASE mono:DosageForm-INTRAUTERINE_DEVICE mono:DosageForm-IRRIGANT mono:DosageForm-JELLY mono:DosageForm-KIT mono:DosageForm-LINIMENT mono:DosageForm-LIPSTICK mono:DosageForm-LIQUID mono:DosageForm-LIQUID_EXTENDED_RELEASE mono:DosageForm-LOTION mono:DosageForm-LOTION_AUGMENTED mono:DosageForm-LOTION_SHAMPOO mono:DosageForm-LOZENGE mono:DosageForm-MOUTHWASH mono:DosageForm-NOT_APPLICABLE mono:DosageForm-OIL mono:DosageForm-OINTMENT mono:DosageForm-OINTMENT_AUGMENTED mono:DosageForm-PASTE mono:DosageForm-PASTE_DENTIFRICE mono:DosageForm-PASTILLE mono:DosageForm-PATCH mono:DosageForm-PATCH_EXTENDED_RELEASE mono:DosageForm-PATCH_EXTENDED_RELEASE_ELECTRICALLY_CONTROLLED mono:DosageForm-PELLET mono:DosageForm-PELLET_IMPLANTABLE mono:DosageForm-PELLETS_COATED_EXTENDED_RELEASE mono:DosageForm-PILL mono:DosageForm-PLASTER mono:DosageForm-POULTICE mono:DosageForm-POWDER mono:DosageForm-POWDER_DENTIFRICE mono:DosageForm-POWDER_FOR_SOLUTION mono:DosageForm-POWDER_FOR_SUSPENSION mono:DosageForm-POWDER_METERED mono:DosageForm-RING mono:DosageForm-RINSE mono:DosageForm-SALVE mono:DosageForm-SHAMPOO mono:DosageForm-SHAMPOO_SUSPENSION mono:DosageForm-SOAP mono:DosageForm-SOLUTION mono:DosageForm-SOLUTION_CONCENTRATE mono:DosageForm-SOLUTION_FOR_SLUSH mono:DosageForm-SOLUTION_GEL_FORMING_DROPS mono:DosageForm-SOLUTION_GEL_FORMING_EXTENDED_RELEASE mono:DosageForm-SOLUTION_DROPS mono:DosageForm-SPONGE mono:Do