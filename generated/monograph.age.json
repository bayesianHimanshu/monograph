{
  "version": "2.2.0",
  "graph": "drug",
  "vertices": [
    {
      "label": "Substance",
      "description": "A chemical or biological substance identified by its FDA Unique Ingredient Identifier.",
      "table": "substance",
      "properties": [
        {
          "name": "iri",
          "type": "string",
          "description": "Canonical identifier (IRI).",
          "column": "iri"
        },
        {
          "name": "unii",
          "type": "string",
          "description": "FDA UNII code.",
          "column": "unii"
        },
        {
          "name": "name",
          "type": "string",
          "description": "Preferred name.",
          "column": "name"
        }
      ]
    },
    {
      "label": "Organization",
      "description": "A company acting as manufacturer, labeler or recalling firm.",
      "table": "organization",
      "properties": [
        {
          "name": "iri",
          "type": "string",
          "description": "Canonical identifier (IRI).",
          "column": "iri"
        },
        {
          "name": "slug",
          "type": "string",
          "description": "Stable key: the normalized name, lowercase, words joined by hyphens.",
          "column": "slug"
        },
        {
          "name": "name",
          "type": "string",
          "description": "Preferred name.",
          "column": "name"
        }
      ]
    },
    {
      "label": "OrganizationAlias",
      "description": "A name variant of an organization, tied to it by an identifier (the NDC labeler code), not by\n    similarity.",
      "table": "organization__aliases",
      "properties": [
        {
          "name": "iri",
          "type": "string",
          "description": "Canonical identifier (IRI).",
          "column": "iri"
        },
        {
          "name": "name",
          "type": "string",
          "description": "The variant.",
          "column": "name"
        },
        {
          "name": "source",
          "type": "string",
          "description": "Record kind. One of: ndc_directory, enforcement, rxnav.",
          "column": "source"
        },
        {
          "name": "evidence",
          "type": "string",
          "description": "The record and identifier that tie the name to the firm.",
          "column": "evidence"
        }
      ]
    },
    {
      "label": "ClinicalDrug",
      "description": "A clinical drug concept in RxNorm, identified by its RxCUI.\n\n    Several NDC products can share one clinical drug. The name is optional because openFDA carries\n    RxCUIs without their RxNorm names.",
      "table": "clinical_drug",
      "properties": [
        {
          "name": "iri",
          "type": "string",
          "description": "Canonical identifier (IRI).",
          "column": "iri"
        },
        {
          "name": "rxcui",
          "type": "string",
          "description": "RxNorm CUI.",
          "column": "rxcui"
        },
        {
          "name": "name",
          "type": "string",
          "description": "RxNorm name.",
          "column": "name"
        },
        {
          "name": "term_type",
          "type": "string",
          "description": "RxNorm term type: SCD generic clinical drug, SBD branded drug, GPCK/BPCK packs.",
          "column": "term_type"
        }
      ]
    },
    {
      "label": "Product",
      "description": "A drug product as listed with FDA, identified by its product NDC (labeler and product segments).",
      "table": "product",
      "properties": [
        {
          "name": "iri",
          "type": "string",
          "description": "Canonical identifier (IRI).",
          "column": "iri"
        },
        {
          "name": "product_ndc",
          "type": "string",
          "description": "Product NDC in 4-4, 5-3 or 5-4 form.",
          "column": "product_ndc"
        },
        {
          "name": "name",
          "type": "string",
          "description": "Name as listed.",
          "column": "name"
        },
        {
          "name": "dosage_form",
          "type": "string",
          "description": "Dosage form as written in the source.",
          "column": "dosage_form"
        },
        {
          "name": "product_type",
          "type": "string",
          "description": "NDC directory product type. One of: HUMAN PRESCRIPTION DRUG, HUMAN OTC DRUG, PLASMA DERIVATIVE, CELLULAR THERAPY, VACCINE, STANDARDIZED ALLERGENIC, NON-STANDARDIZED ALLERGENIC, BULK INGREDIENT, DRUG FOR FURTHER PROCESSING, LICENSED VACCINE BULK INTERMEDIATE.",
          "column": "product_type"
        },
        {
          "name": "finished",
          "type": "boolean",
          "description": "Whether this is a finished product (False for bulk ingredients and intermediates).",
          "column": "finished"
        },
        {
          "name": "routes",
          "type": "list of strings",
          "description": "Routes of administration. Required for finished prescription and OTC products.",
          "column": "routes"
        }
      ]
    },
    {
      "label": "PackagedProduct",
      "description": "A package of a product, identified by its 10-digit hyphenated package NDC.",
      "table": "packaged_product",
      "properties": [
        {
          "name": "iri",
          "type": "string",
          "description": "Canonical identifier (IRI).",
          "column": "iri"
        },
        {
          "name": "ndc",
          "type": "string",
          "description": "Package NDC in 4-4-2, 5-3-2 or 5-4-1 form.",
          "column": "ndc"
        },
        {
          "name": "description",
          "type": "string",
          "description": "Package description as written in the source.",
          "column": "description"
        },
        {
          "name": "ndc11",
          "type": "string",
          "description": "The same NDC in the 11-digit 5-4-2 form without hyphens (HIPAA form): a leading zero is added to the short segment.",
          "column": "ndc11"
        }
      ]
    },
    {
      "label": "Label",
