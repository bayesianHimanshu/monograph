      "table": "label",
      "properties": [
        {
          "name": "iri",
          "type": "string",
          "description": "Canonical identifier (IRI).",
          "column": "iri"
        },
        {
          "name": "set_id",
          "type": "string",
          "description": "SPL set ID, a lowercase UUID.",
          "column": "set_id"
        },
        {
          "name": "version",
          "type": "integer",
          "description": "SPL version.",
          "column": "version"
        },
        {
          "name": "effective_date",
          "type": "string (ISO date, YYYY-MM-DD)",
          "description": "SPL effective time.",
          "column": "effective_date"
        }
      ]
    },
    {
      "label": "LabelSection",
      "description": "One LOINC-coded section of a structured product label.",
      "table": "label__sections",
      "properties": [
        {
          "name": "iri",
          "type": "string",
          "description": "Canonical identifier (IRI).",
          "column": "iri"
        },
        {
          "name": "code",
          "type": "string",
          "description": "LOINC code.",
          "column": "code"
        },
        {
          "name": "title",
          "type": "string",
          "description": "Title.",
          "column": "title"
        },
        {
          "name": "text",
          "type": "string",
          "description": "Plain text.",
          "column": "text"
        }
      ]
    },
    {
      "label": "AdverseEventReport",
      "description": "A safety report from FDA adverse event data (FAERS, now FDA AEMS), via openFDA.",
      "table": "adverse_event_report",
      "properties": [
        {
          "name": "iri",
          "type": "string",
          "description": "Canonical identifier (IRI).",
          "column": "iri"
        },
        {
          "name": "report_id",
          "type": "string",
          "description": "Safety report ID, optionally with a -digits version suffix.",
          "column": "report_id"
        },
        {
          "name": "source_system",
          "type": "string",
          "description": "Where the report came from. One of: openfda_e2b, faers_qde.",
          "column": "source_system"
        },
        {
          "name": "receipt_date",
          "type": "string (ISO date, YYYY-MM-DD)",
          "description": "Date FDA received the report.",
          "column": "receipt_date"
        },
        {
          "name": "serious",
          "type": "boolean",
          "description": "Whether the report is serious.",
          "column": "serious"
        },
        {
          "name": "seriousness_criteria",
          "type": "list of strings",
          "description": "Seriousness criteria met. One of: death, life threatening, hospitalization, disabling, congenital anomaly, other.",
          "column": "seriousness_criteria"
        },
        {
          "name": "patient_age_years",
          "type": "number",
          "description": "Patient age at onset, in years.",
          "column": "patient_age_years"
        }
      ]
    },
    {
      "label": "DrugInvolvement",
      "description": "A drug mentioned in an adverse event report, as reported.",
      "table": "adverse_event_report__drugs",
      "properties": [
        {
          "name": "iri",
          "type": "string",
          "description": "Canonical identifier (IRI).",
          "column": "iri"
        },
        {
          "name": "drug_name",
          "type": "string",
          "description": "Drug name exactly as reported.",
          "column": "drug_name"
        },
        {
          "name": "role",
          "type": "string",
          "description": "Role in the report. One of: primary suspect, secondary suspect, suspect, concomitant, interacting.",
          "column": "role"
        },
        {
          "name": "position",
          "type": "integer",
          "description": "Position in the owner's list, from 0.",
          "column": "position"
        }
      ]
    },
    {
      "label": "Reaction",
      "description": "A reaction, as a MedDRA preferred term string. No MedDRA hierarchy is shipped (licensed).",
      "table": "adverse_event_report__reactions",
      "properties": [
        {
          "name": "iri",
          "type": "string",
          "description": "Canonical identifier (IRI).",
          "column": "iri"
        },
        {
          "name": "term",
          "type": "string",
          "description": "MedDRA PT text (at most 100 characters).",
          "column": "term"
        },
        {
          "name": "position",
          "type": "integer",
          "description": "Position in the owner's list, from 0.",
          "column": "position"
        }
      ]
    },
    {
      "label": "Recall",
      "description": "A drug recall from the FDA enforcement report.",
      "table": "recall",
      "properties": [
        {
          "name": "iri",
          "type": "string",
          "description": "Canonical identifier (IRI).",
          "column": "iri"
        },
        {
          "name": "recall_number",
          "type": "string",
          "description": "FDA recall number, for example D-321-2016 or D-0123-2025.",
          "column": "recall_number"
        },
        {
          "name": "classification",
          "type": "string",
          "description": "Class. One of: I, II, III.",
          "column": "classification"
        },
        {
          "name": "reason",
          "type": "string",
          "description": "Reason for the recall.",
          "column": "reason"
        },
        {
          "name": "report_date",
          "type": "string (ISO date, YYYY-MM-DD)",
          "description": "Enforcement report date.",
          "column": "report_date"
        }
      ]
    }
