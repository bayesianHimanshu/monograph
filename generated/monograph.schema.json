    "Product": {
      "additionalProperties": false,
      "allOf": [
        {
          "$comment": "rule finished-rx-otc-requires-route: a finished prescription or OTC product needs at least one route",
          "if": {
            "properties": {
              "finished": {
                "enum": [
                  true
                ]
              },
              "product_type": {
                "enum": [
                  "HUMAN PRESCRIPTION DRUG",
                  "HUMAN OTC DRUG"
                ]
              }
            },
            "required": [
              "finished",
              "product_type"
            ]
          },
          "then": {
            "properties": {
              "routes": {
                "minItems": 1
              }
            },
            "required": [
              "routes"
            ]
          }
        }
      ],
      "description": "A drug product as listed with FDA, identified by its product NDC (labeler and product segments).",
      "properties": {
        "clinical_drug": {
          "anyOf": [
            {
              "pattern": "^https?://[A-Za-z0-9._~:/?#@!$&'()*+,;=%\\-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The RxNorm clinical drug, when the source names exactly one.",
          "title": "Clinical Drug",
          "x-rdf-property": "https://example.org/monograph/ontology#clinicalDrug"
        },
        "dosage_form": {
          "description": "Dosage form as written in the source.",
          "maxLength": 100,
          "minLength": 1,
          "not": {
            "pattern": "[\u0000-\b\u000b-\f\u000e-\u001f\u007f-\u009f]"
          },
          "title": "Dosage Form",
          "type": "string",
          "x-rdf-property": "https://example.org/monograph/ontology#dosageForm"
        },
        "finished": {
          "description": "Whether this is a finished product (False for bulk ingredients and intermediates).",
