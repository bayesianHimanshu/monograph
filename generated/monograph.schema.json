          "type": "boolean",
          "x-rdf-property": "https://example.org/monograph/ontology#finished"
        },
        "ingredients": {
          "default": [],
          "description": "Active ingredients, in order.",
          "items": {
            "$ref": "#/$defs/Ingredient"
