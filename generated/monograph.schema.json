{
  "$defs": {
    "AdverseEventReport": {
      "additionalProperties": false,
      "allOf": [
        {
          "$comment": "rule serious-requires-criterion: a serious report needs at least one seriousness criterion",
          "if": {
            "properties": {
              "serious": {
                "enum": [
                  true
                ]
              }
            },
            "required": [
              "serious"
            ]
          },
          "then": {
            "properties": {
              "seriousness_criteria": {
                "minItems": 1
              }
            },
            "required": [
              "seriousness_criteria"
            ]
          }
        },
        {
          "$comment": "rule has-suspect: a report needs at least one suspect drug (primary, secondary or unspecified)",
          "properties": {
            "drugs": {
              "contains": {
                "properties": {
                  "role": {
                    "enum": [
                      "primary suspect",
                      "secondary suspect",
                      "suspect"
                    ]
                  }
                },
                "required": [
                  "role"
                ]
              },
              "minContains": 1
            }
          }
        }
      ],
      "description": "A safety report from FDA adverse event data (FAERS, now FDA AEMS), via openFDA.",
      "properties": {
        "drugs": {
          "description": "Drugs, in reported order.",
          "items": {
            "$ref": "#/$defs/DrugInvolvement"
          },
          "minItems": 1,
          "title": "Drugs",
          "type": "array",
          "x-rdf-property": "https://example.org/monograph/ontology#drugInvolvement"
        },
        "patient_age_years": {
          "anyOf": [
            {
              "maximum": 150,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Patient age at onset, in years.",
          "title": "Patient Age Years",
          "x-rdf-property": "https://example.org/monograph/ontology#patientAgeYears"
        },
        "reactions": {
          "description": "Reactions, in order.",
          "items": {
            "$ref": "#/$defs/Reaction"
          },
          "minItems": 1,
          "title": "Reactions",
          "type": "array",
          "x-rdf-property": "https://example.org/monograph/ontology#reaction"
        },
        "receipt_date": {
          "description": "Date FDA received the report.",
          "format": "date",
          "title": "Receipt Date",
          "type": "string",
          "x-rdf-property": "https://example.org/monograph/ontology#receiptDate"
        },
        "report_id": {
          "description": "Safety report ID, optionally with a -digits version suffix.",
          "not": {
            "pattern": "[\u0000-\u001f\u007f-\u009f]"
          },
          "pattern": "^[0-9]{1,12}(-[0-9]{1,3})?$",
          "title": "Report Id",
          "type": "string",
          "x-rdf-property": "https://example.org/monograph/ontology#safetyReportId"
        },
        "serious": {
          "description": "Whether the report is serious.",
          "title": "Serious",
          "type": "boolean",
          "x-rdf-property": "https://example.org/monograph/ontology#serious"
        },
        "seriousness_criteria": {
          "default": [],
          "description": "Seriousness criteria met.",
          "items": {
            "$ref": "#/$defs/SeriousnessCriterion"
          },
          "maxItems": 6,
          "title": "Seriousness Criteria",
          "type": "array",
          "uniqueItems": true,
          "x-rdf-property": "https://example.org/monograph/ontology#seriousnessCriterion"
        },
        "source_system": {
          "$ref": "#/$defs/SourceSystem",
          "description": "Where the report came from.",
          "x-rdf-property": "https://example.org/monograph/ontology#sourceSystem"
        }
      },
      "required": [
        "report_id",
        "source_system",
        "receipt_date",
        "serious",
        "drugs",
        "reactions"
      ],
      "title": "AdverseEventReport",
      "type": "object",
      "x-rdf-class": "https://example.org/monograph/ontology#AdverseEventReport"
    },
    "ClinicalDrug": {
      "additionalProperties": false,
      "description": "A clinical drug concept in RxNorm, identified by its RxCUI.\n\nSeveral NDC products can share one clinical drug. The name is optional because openFDA carries\nRxCUIs without their RxNorm names.",
      "properties": {
        "name": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "not": {
                "pattern": "[\u0000-\b\u000b-\f\u000e-\u001f\u007f-\u009f]"
              },
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "RxNorm name.",
          "title": "Name",
          "x-rdf-property": "https://example.org/monograph/ontology#name"
        },
        "rxcui": {
          "description": "RxNorm CUI.",
          "not": {
            "pattern": "[\u0000-\u001f\u007f-\u009f]"
          },
          "pattern": "^[0-9]{1,8}$",
          "title": "Rxcui",
          "type": "string",
          "x-rdf-property": "https://example.org/monograph/ontology#rxcui"
        }
      },
      "required": [
        "rxcui"
      ],
      "title": "ClinicalDrug",
      "type": "object",
      "x-rdf-class": "https://example.org/monograph/ontology#ClinicalDrug"
    },
    "DosageForm": {
      "description": "Dosage form: the FDA SPL dosage form terms, with NCI Thesaurus codes.\n\nSource: https://www.fda.gov/industry/structured-product-labeling-resources/dosage-forms\n(content current as of 02/03/2022). 158 terms.",
      "enum": [
        "AEROSOL",
        "AEROSOL, FOAM",
        "AEROSOL, METERED",
        "AEROSOL, POWDER",
        "AEROSOL, SPRAY",
        "BAR, CHEWABLE",
        "BEAD",
        "CAPSULE",
        "CAPSULE, COATED",
        "CAPSULE, COATED PELLETS",
        "CAPSULE, COATED, EXTENDED RELEASE",
        "CAPSULE, DELAYED RELEASE",
        "CAPSULE, DELAYED RELEASE PELLETS",
        "CAPSULE, EXTENDED RELEASE",
        "CAPSULE, FILM COATED, EXTENDED RELEASE",
        "CAPSULE, GELATIN COATED",
        "CAPSULE, LIQUID FILLED",
        "CELLULAR SHEET",
        "CHEWABLE GEL",
        "CLOTH",
        "CONCENTRATE",
        "CREAM",
        "CREAM, AUGMENTED",
        "CRYSTAL",
        "DISC",
        "DOUCHE",
        "DRESSING",
        "DRUG-ELUTING CONTACT LENS",
        "ELIXIR",
        "EMULSION",
        "ENEMA",
        "EXTRACT",
        "FIBER, EXTENDED RELEASE",
        "FILM",
        "FILM, EXTENDED RELEASE",
        "FILM, SOLUBLE",
        "FOR SOLUTION",
        "FOR SUSPENSION",
        "FOR SUSPENSION, EXTENDED RELEASE",
        "GAS",
        "GEL",
        "GEL, DENTIFRICE",
        "GEL, METERED",
        "GLOBULE",
        "GRANULE",
        "GRANULE, DELAYED RELEASE",
        "GRANULE, EFFERVESCENT",
        "GRANULE, FOR SOLUTION",
        "GRANULE, FOR SUSPENSION",
        "GRANULE, FOR SUSPENSION, EXTENDED RELEASE",
        "GUM, CHEWING",
        "IMPLANT",
        "INHALANT",
        "INJECTABLE FOAM",
        "INJECTABLE, LIPOSOMAL",
        "INJECTION",
        "INJECTION, EMULSION",
        "INJECTION, LIPID COMPLEX",
        "INJECTION, POWDER, FOR SOLUTION",
        "INJECTION, POWDER, FOR SUSPENSION",
        "INJECTION, POWDER, FOR SUSPENSION, EXTENDED RELEASE",
        "INJECTION, POWDER, LYOPHILIZED, FOR LIPOSOMAL SUSPENSION",
        "INJECTION, POWDER, LYOPHILIZED, FOR SOLUTION",
        "INJECTION, POWDER, LYOPHILIZED, FOR SUSPENSION",
        "INJECTION, POWDER, LYOPHILIZED, FOR SUSPENSION, EXTENDED RELEASE",
        "INJECTION, SOLUTION",
        "INJECTION, SOLUTION, CONCENTRATE",
        "INJECTION, SUSPENSION",
        "INJECTION, SUSPENSION, EXTENDED RELEASE",
        "INJECTION, SUSPENSION, LIPOSOMAL",
        "INJECTION, SUSPENSION, SONICATED",
        "INSERT",
        "INSERT, EXTENDED RELEASE",
        "INTRAUTERINE DEVICE",
        "IRRIGANT",
        "JELLY",
        "KIT",
        "LINIMENT",
        "LIPSTICK",
        "LIQUID",
        "LIQUID, EXTENDED RELEASE",
        "LOTION",
        "LOTION, AUGMENTED",
        "LOTION/SHAMPOO",
        "LOZENGE",
        "MOUTHWASH",
        "NOT APPLICABLE",
        "OIL",
        "OINTMENT",
        "OINTMENT, AUGMENTED",
        "PASTE",
        "PASTE, DENTIFRICE",
        "PASTILLE",
        "PATCH",
        "PATCH, EXTENDED RELEASE",
        "PATCH, EXTENDED RELEASE, ELECTRICALLY CONTROLLED",
        "PELLET",
        "PELLET, IMPLANTABLE",
        "PELLETS, COATED, EXTENDED RELEASE",
        "PILL",
        "PLASTER",
        "POULTICE",
        "POWDER",
        "POWDER, DENTIFRICE",
        "POWDER, FOR SOLUTION",
        "POWDER, FOR SUSPENSION",
        "POWDER, METERED",
        "RING",
        "RINSE",
        "SALVE",
        "SHAMPOO",
        "SHAMPOO, SUSPENSION",
        "SOAP",
        "SOLUTION",
        "SOLUTION, CONCENTRATE",
        "SOLUTION, FOR SLUSH",
        "SOLUTION, GEL FORMING / DROPS",
        "SOLUTION, GEL FORMING, EXTENDED RELEASE",
        "SOLUTION/ DROPS",
        "SPONGE",
        "SPRAY",
        "SPRAY, METERED",
        "SPRAY, SUSPENSION",
        "STICK",
        "STRIP",
        "SUPPOSITORY",
        "SUPPOSITORY, EXTENDED RELEASE",
        "SUSPENSION",
        "SUSPENSION, EXTENDED RELEASE",
        "SUSPENSION/ DROPS",
        "SWAB",
        "SYRUP",
        "SYSTEM",
        "TABLET",
        "TABLET, CHEWABLE",
        "TABLET, CHEWABLE, EXTENDED RELEASE",
        "TABLET, COATED",
        "TABLET, COATED PARTICLES",
        "TABLET, DELAYED RELEASE",
        "TABLET, DELAYED RELEASE PARTICLES",
        "TABLET, EFFERVESCENT",
        "TABLET, EXTENDED RELEASE",
        "TABLET, FILM COATED",
        "TABLET, FILM COATED, EXTENDED RELEASE",
        "TABLET, FOR SOLUTION",
        "TABLET, FOR SUSPENSION",
        "TABLET, MULTILAYER",
        "TABLET, MULTILAYER, EXTENDED RELEASE",
        "TABLET, ORALLY DISINTEGRATING",
        "TABLET, ORALLY DISINTEGRATING, DELAYED RELEASE",
        "TABLET, SOLUBLE",
        "TABLET, SUGAR COATED",
        "TABLET WITH SENSOR",
        "TAMPON",
        "TAPE",
        "TINCTURE",
        "TROCHE",
        "WAFER"
      ],
      "title": "DosageForm",
      "type": "string"
    },
    "DrugInvolvement": {
      "additionalProperties": false,
      "description": "A drug mentioned in an adverse event report, as reported.",
      "properties": {
        "clinical_drug": {
          "anyOf": [
            {
              "pattern": "^https?://[A-Za-z0-9._~:/?#@!$&'()*+,;=%\\-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The RxNorm clinical drug, when the source resolves the name to exactly one RxCUI.",
          "title": "Clinical Drug",
          "x-rdf-property": "https://example.org/monograph/ontology#clinicalDrug"
        },
        "drug_name": {
          "description": "Drug name exactly as reported.",
          "maxLength": 500,
          "minLength": 1,
          "not": {
            "pattern": "[\u0000-\b\u000b-\f\u000e-\u001f\u007f-\u009f]"
          },
          "title": "Drug Name",
          "type": "string",
          "x-rdf-property": "https://example.org/monograph/ontology#verbatimDrugName"
        },
        "role": {
          "$ref": "#/$defs/DrugRole",
          "description": "Role in the report.",
          "x-rdf-property": "https://example.org/monograph/ontology#drugRole"
        }
      },
      "required": [
        "drug_name",
        "role"
      ],
      "title": "DrugInvolvement",
      "type": "object",
      "x-rdf-class": "https://example.org/monograph/ontology#DrugInvolvement"
    },
    "DrugRole": {
      "description": "The role a drug played in an adverse event report.\n\n`suspect` is E2B characterization 1 when the source does not say which suspect is primary.",
      "enum": [
        "primary suspect",
        "secondary suspect",
        "suspect",
        "concomitant",
        "interacting"
      ],
      "title": "DrugRole",
      "type": "string"
    },
    "ExtractedIngredient": {
      "additionalProperties": false,
      "description": "An active ingredient as stated in label narrative: name, strength and the basis of the strength.",
      "properties": {
        "basis_unit": {
          "$ref": "#/$defs/UcumUnit",
          "description": "Unit of the basis: mL in 'per 5 mL', '1' for per tablet or capsule.",
          "x-rdf-property": "https://example.org/monograph/ontology#basisUnit"
        },
        "basis_value": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "description": "Amount the strength refers to, for example 5 in 'per 5 mL'; 1 for per unit.",
          "title": "Basis Value",
          "x-rdf-property": "https://example.org/monograph/ontology#basisValue"
        },
        "resolved_substance": {
          "anyOf": [
            {
              "pattern": "^https?://[A-Za-z0-9._~:/?#@!$&'()*+,;=%\\-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The Substance this name resolves to in the reference graph.",
          "title": "Resolved Substance",
          "x-rdf-property": "https://example.org/monograph/ontology#resolvedSubstance"
        },
        "strength_unit": {
          "$ref": "#/$defs/UcumUnit",
          "description": "Unit of the strength.",
          "x-rdf-property": "https://example.org/monograph/ontology#strengthUcumUnit"
        },
        "strength_value": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "description": "Numeric strength.",
          "title": "Strength Value",
          "x-rdf-property": "https://example.org/monograph/ontology#strengthValue"
        },
        "substance_name": {
          "description": "Substance name exactly as the label states it.",
          "maxLength": 500,
          "minLength": 1,
          "not": {
            "pattern": "[\u0000-\b\u000b-\f\u000e-\u001f\u007f-\u009f]"
          },
          "title": "Substance Name",
          "type": "string",
          "x-rdf-property": "https://example.org/monograph/ontology#substanceName"
        }
      },
      "required": [
        "substance_name",
        "strength_value",
        "strength_unit",
        "basis_value",
        "basis_unit"
      ],
      "title": "ExtractedIngredient",
      "type": "object",
      "x-rdf-class": "https://example.org/monograph/ontology#ExtractedIngredient"
    },
    "ExtractedPackage": {
      "additionalProperties": false,
      "allOf": [
        {
          "$comment": "rule listed-package-resolves: the registry lists this label's products, so the NDC must be one of their packages",
          "if": {
            "properties": {
              "registry_lists_product": {
                "enum": [
                  true
                ]
              }
            },
            "required": [
              "registry_lists_product"
            ]
          },
          "then": {
            "required": [
              "resolved_package"
            ]
          }
        }
      ],
      "description": "A package NDC mentioned in label narrative (for example in How Supplied).",
      "properties": {
        "ndc": {
          "description": "Package NDC in 4-4-2, 5-3-2 or 5-4-1 form.",
          "not": {
            "pattern": "[\u0000-\u001f\u007f-\u009f]"
          },
          "pattern": "^([0-9]{4}-[0-9]{4}-[0-9]{2}|[0-9]{5}-[0-9]{3}-[0-9]{2}|[0-9]{5}-[0-9]{4}-[0-9])$",
          "title": "Ndc",
          "type": "string",
          "x-rdf-property": "https://example.org/monograph/ontology#ndc"
        },
        "registry_lists_product": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "True when the registry knows this label's products, so its packages must resolve.",
          "title": "Registry Lists Product",
          "x-rdf-property": "https://example.org/monograph/ontology#registryListsProduct"
        },
        "resolved_package": {
          "anyOf": [
            {
              "pattern": "^https?://[A-Za-z0-9._~:/?#@!$&'()*+,;=%\\-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The PackagedProduct with this NDC in the reference graph.",
          "title": "Resolved Package",
          "x-rdf-property": "https://example.org/monograph/ontology#resolvedPackage"
        }
      },
      "required": [
        "ndc"
      ],
      "title": "ExtractedPackage",
      "type": "object",
      "x-rdf-class": "https://example.org/monograph/ontology#ExtractedPackage"
    },
    "ExtractedProduct": {
      "additionalProperties": false,
      "description": "One product described by a label: what it is made of, its form, its routes, its packages.",
      "properties": {
        "dosage_form": {
          "$ref": "#/$defs/DosageForm",
          "description": "Dosage form.",
          "x-rdf-property": "https://example.org/monograph/ontology#extractedDosageForm"
        },
        "ingredients": {
          "description": "Active ingredients with strengths, in label order.",
          "items": {
            "$ref": "#/$defs/ExtractedIngredient"
          },
          "minItems": 1,
          "title": "Ingredients",
          "type": "array",
          "x-rdf-property": "https://example.org/monograph/ontology#extractedIngredient"
        },
        "name": {
          "description": "Product name.",
          "maxLength": 500,
          "minLength": 1,
          "not": {
            "pattern": "[\u0000-\b\u000b-\f\u000e-\u001f\u007f-\u009f]"
          },
          "title": "Name",
          "type": "string",
          "x-rdf-property": "https://example.org/monograph/ontology#name"
        },
        "packages": {
          "default": [],
          "description": "Package NDCs the label lists for this product.",
          "items": {
            "$ref": "#/$defs/ExtractedPackage"
          },
          "title": "Packages",
          "type": "array",
          "x-rdf-property": "https://example.org/monograph/ontology#extractedPackage"
        },
        "routes": {
          "description": "Routes of administration.",
          "items": {
            "$ref": "#/$defs/Route"
          },
          "minItems": 1,
          "title": "Routes",
          "type": "array",
          "uniqueItems": true,
          "x-rdf-property": "https://example.org/monograph/ontology#route"
        }
      },
      "required": [
        "name",
        "dosage_form",
        "routes",
        "ingredients"
      ],
      "title": "ExtractedProduct",
      "type": "object",
      "x-rdf-class": "https://example.org/monograph/ontology#ExtractedProduct"
    },
    "Ingredient": {
      "additionalProperties": false,
      "description": "An active ingredient of a product with its strength.",
      "properties": {
        "strength_unit": {
          "description": "Unit of the strength, for example mg/1.",
          "maxLength": 50,
          "minLength": 1,
          "not": {
            "pattern": "[\u0000-\u001f\u007f-\u009f]"
          },
          "title": "Strength Unit",
          "type": "string",
          "x-rdf-property": "https://example.org/monograph/ontology#strengthUnit"
        },
        "strength_value": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "description": "Numeric strength.",
          "title": "Strength Value",
          "x-rdf-property": "https://example.org/monograph/ontology#strengthValue"
        },
        "substance": {
          "description": "The substance.",
          "pattern": "^https?://[A-Za-z0-9._~:/?#@!$&'()*+,;=%\\-]+$",
          "title": "Substance",
          "type": "string",
          "x-rdf-property": "https://example.org/monograph/ontology#substance"
        }
      },
      "required": [
        "substance",
        "strength_value",
        "strength_unit"
      ],
      "title": "Ingredient",
      "type": "object",
      "x-rdf-class": "https://example.org/monograph/ontology#Ingredient"
    },
    "Label": {
      "additionalProperties": false,
      "description": "One version of a structured product label (SPL).",
      "properties": {
        "effective_date": {
          "description": "SPL effective time.",
          "format": "date",
          "title": "Effective Date",
          "type": "string",
          "x-rdf-property": "https://example.org/monograph/ontology#effectiveDate"
        },
        "products": {
          "default": [],
          "description": "Products.",
          "items": {
            "pattern": "^https?://[A-Za-z0-9._~:/?#@!$&'()*+,;=%\\-]+$",
            "type": "string"
          },
          "title": "Products",
          "type": "array",
          "uniqueItems": true,
          "x-rdf-property": "https://example.org/monograph/ontology#labelsProduct"
        },
        "sections": {
          "default": [],
          "description": "Coded sections.",
          "items": {
            "$ref": "#/$defs/LabelSection"
          },
          "title": "Sections",
          "type": "array",
          "uniqueItems": true,
          "x-rdf-property": "https://example.org/monograph/ontology#section"
        },
        "set_id": {
          "description": "SPL set ID, a lowercase UUID.",
          "not": {
            "pattern": "[\u0000-\u001f\u007f-\u009f]"
          },
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Set Id",
          "type": "string",
          "x-rdf-property": "https://example.org/monograph/ontology#setId"
        },
        "version": {
          "description": "SPL version.",
          "exclusiveMaximum": 1000000,
          "minimum": 1,
          "title": "Version",
          "type": "integer",
          "x-rdf-property": "https://example.org/monograph/ontology#labelVersion"
        }
      },
      "required": [
        "set_id",
        "version",
        "effective_date"
      ],
      "title": "Label",
      "type": "object",
      "x-rdf-class": "https://example.org/monograph/ontology#Label"
    },
    "LabelExtraction": {
      "additionalProperties": false,
      "description": "What an extractor read from one label's narrative, plus the label it came from.",
      "properties": {
        "products": {
          "description": "Products the label describes.",
          "items": {
            "$ref": "#/$defs/ExtractedProduct"
          },
          "minItems": 1,
          "title": "Products",
          "type": "array",
          "x-rdf-property": "https://example.org/monograph/ontology#extractedProduct"
        },
