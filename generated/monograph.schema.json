          "type": "string",
          "x-rdf-property": "https://example.org/monograph/ontology#productNdc"
        },
        "product_type": {
          "$ref": "#/$defs/ProductType",
          "description": "NDC directory product type.",
          "x-rdf-property": "https://example.org/monograph/ontology#productType"
        },
        "routes": {
