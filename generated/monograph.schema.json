          "title": "Ingredients",
          "type": "array",
          "x-rdf-property": "https://example.org/monograph/ontology#ingredient"
        },
        "name": {
          "description": "Name as listed.",
          "maxLength": 500,
          "minLength": 1,
          "not": {
            "pattern": "[\u0000-\b\u000b-\f\u000e-\u001f\u007f-\u009f]"
          },
          "title": "Name",
          "type": "string",
          "x-rdf-property": "https://example.org/monograph/ontology#name"
        },
        "product_ndc": {
          "description": "Product NDC in 4-4, 5-3 or 5-4 form.",
          "not": {
            "pattern": "[\u0000-\u001f\u007f-\u009f]"
          },
          "pattern": "^([0-9]{4}-[0-9]{4}|[0-9]{5}-[0-9]{3}|[0-9]{5}-[0-9]{4})$",
