mono:basisUnit
    a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:comment "Unit of the basis: mL in 'per 5 mL', '1' for per tablet or capsule." ;
    rdfs:domain mono:ExtractedIngredient ;
    rdfs:label "basis unit (UCUM)" ;
    rdfs:range mono:UcumUnit .

mono:basisValue
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:comment "Amount the strength refers to, for example 5 in 'per 5 mL'; 1 for per unit." ;
    rdfs:domain mono:ExtractedIngredient ;
    rdfs:label "basis value" ;
    rdfs:range xsd:decimal .

mono:clinicalDrug
    a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf ( mono:DrugInvolvement mono:Product )
    ] ;
    rdfs:label "clinical drug" ;
    rdfs:range mono:ClinicalDrug .

mono:dosageForm
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:comment "Dosage form as written in the source." ;
    rdfs:domain mono:Product ;
    rdfs:label "dosage form" ;
    rdfs:range xsd:string .

mono:drugInvolvement
    a owl:ObjectProperty ;
    rdfs:comment "Drugs, in reported order." ;
    rdfs:domain mono:AdverseEventReport ;
    rdfs:label "drug involvement" ;
    rdfs:range mono:DrugInvolvement .

mono:drugRole
    a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:comment "Role in the report." ;
    rdfs:domain mono:DrugInvolvement ;
    rdfs:label "drug role" ;
    rdfs:range mono:DrugRole .

mono:effectiveDate
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:comment "SPL effective time." ;
    rdfs:domain mono:Label ;
    rdfs:label "effective date" ;
    rdfs:range xsd:date .

mono:extractedDosageForm
    a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:comment "Dosage form." ;
    rdfs:domain mono:ExtractedProduct ;
    rdfs:label "dosage form (SPL term)" ;
    rdfs:range mono:DosageForm .

mono:extractedIngredient
    a owl:ObjectProperty ;
    rdfs:comment "Active ingredients with strengths, in label order." ;
    rdfs:domain mono:ExtractedProduct ;
    rdfs:label "extracted ingredient" ;
    rdfs:range mono:ExtractedIngredient .

mono:extractedPackage
    a owl:ObjectProperty ;
    rdfs:comment "Package NDCs the label lists for this product." ;
    rdfs:domain mono:ExtractedProduct ;
    rdfs:label "extracted package" ;
    rdfs:range mono:ExtractedPackage .

mono:extractedProduct
    a owl:ObjectProperty ;
    rdfs:comment "Products the label describes." ;
    rdfs:domain mono:LabelExtraction ;
    rdfs:label "extracted product" ;
    rdfs:range mono:ExtractedProduct .

mono:finished
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:comment "Whether this is a finished product (False for bulk ingredients and intermediates)." ;
    rdfs:domain mono:Product ;
    rdfs:label "finished" ;
    rdfs:range xsd:boolean .

mono:ingredient
    a owl:ObjectProperty ;
    rdfs:comment "Active ingredients, in order." ;
    rdfs:domain mono:Product ;
    rdfs:label "ingredient" ;
    rdfs:range mono:Ingredient .

mono:labelVersion
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf ( mono:Label mono:LabelExtraction )
    ] ;
    rdfs:label "label version" ;
    rdfs:range xsd:integer .

mono:labeler
    a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:comment "The labeler firm." ;
    rdfs:domain mono:PackagedProduct ;
    rdfs:label "labeler" ;
    rdfs:range mono:Organization .

mono:labelsProduct
    a owl:ObjectProperty ;
    rdfs:comment "Products." ;
    rdfs:domain mono:Label ;
    rdfs:label "labels product" ;
    rdfs:range mono:Product .

mono:loincCode
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:comment "LOINC code." ;
    rdfs:domain mono:LabelSection ;
    rdfs:label "LOINC code" ;
    rdfs:range xsd:string .

mono:meddraPreferredTerm
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:comment "MedDRA PT text (at most 100 characters)." ;
    rdfs:domain mono:Reaction ;
    rdfs:label "MedDRA preferred term" ;
    rdfs:range xsd:string .

mono:name
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf ( mono:ClinicalDrug mono:ExtractedProduct mono:Organization mono:Product mono:Substance )
    ] ;
    rdfs:label "name" ;
    rdfs:range xsd:string .

mono:ndc
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:comment "Package NDC in 4-4-2, 5-3-2 or 5-4-1 form." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf ( mono:ExtractedPackage mono:PackagedProduct )
    ] ;
    rdfs:label "NDC" ;
    rdfs:range xsd:string .

mono:packageDescription
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:comment "Package description as written in the source." ;
    rdfs:domain mono:PackagedProduct ;
    rdfs:label "package description" ;
    rdfs:range xsd:string .

mono:patientAgeYears
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:comment "Patient age at onset, in years." ;
    rdfs:domain mono:AdverseEventReport ;
    rdfs:label "patient age in years" ;
    rdfs:range xsd:decimal .

mono:product
    a owl:FunctionalProperty, owl:ObjectProperty ;
