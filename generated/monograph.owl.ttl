    rdfs:domain mono:AdverseEventReport ;
    rdfs:label "receipt date" ;
    rdfs:range xsd:date .

mono:registryListsProduct
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:comment "True when the registry knows this label's products, so its packages must resolve." ;
    rdfs:domain mono:ExtractedPackage ;
    rdfs:label "registry lists the label's products" ;
    rdfs:range xsd:boolean .

mono:reportDate
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:comment "Enforcement report date." ;
    rdfs:domain mono:Recall ;
    rdfs:label "report date" ;
    rdfs:range xsd:date .

mono:resolvedPackage
    a owl:FunctionalProperty, owl:ObjectProperty ;
