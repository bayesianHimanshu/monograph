@prefix mono: <https://example.org/monograph/ontology#> .
@prefix shape: <https://example.org/monograph/shapes#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/monograph/ontology>
    a owl:Ontology ;
    owl:versionIRI <https://example.org/monograph/ontology/2.1.0> ;
    owl:versionInfo "2.1.0" ;
    rdfs:label "MONOGRAPH drug product model" .

mono:AdverseEventReport
    a owl:Class ;
    rdfs:comment "A safety report from FDA adverse event data (FAERS, now FDA AEMS), via openFDA." ;
    rdfs:label "Adverse event report" ;
    rdfs:subClassOf mono:Entity .

mono:ClinicalDrug
    a owl:Class ;
    rdfs:comment "A clinical drug concept in RxNorm, identified by its RxCUI. Several NDC products can share one clinical drug. The name is optional because openFDA carries RxCUIs without their RxNorm names." ;
    rdfs:label "Clinical drug" ;
    rdfs:subClassOf mono:Entity .

mono:DosageForm
    a owl:Class ;
    rdfs:comment "Dosage form: the FDA SPL dosage form terms, with NCI Thesaurus codes. Source: https://www.fda.gov/industry/structured-product-labeling-resources/dosage-forms (content current as of 02/03/2022). 158 terms." ;
    rdfs:label "Dosage form" .

