    rdfs:domain mono:ExtractedPackage ;
    rdfs:label "resolved package" ;
    rdfs:range mono:PackagedProduct .

mono:resolvedSubstance
    a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:comment "The Substance this name resolves to in the reference graph." ;
    rdfs:domain mono:ExtractedIngredient ;
    rdfs:label "resolved substance" ;
    rdfs:range mono:Substance .

