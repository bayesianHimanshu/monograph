    a owl:Class ;
    rdfs:comment "Unit of measure: the UCUM codes FDA accepts in SPL. \"1\" is the unit of presentation (per tablet, per capsule, ...). Source: https://www.fda.gov/industry/structured-product-labeling-resources/units-measure (content current as of 10/24/2024). 52 units." ;
    rdfs:label "UCUM unit" .

