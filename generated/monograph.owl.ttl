    rdfs:domain mono:Ingredient ;
    rdfs:label "substance" ;
    rdfs:range mono:Substance .

mono:substanceName
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:comment "Substance name exactly as the label states it." ;
    rdfs:domain mono:ExtractedIngredient ;
    rdfs:label "substance name" ;
    rdfs:range xsd:string .

