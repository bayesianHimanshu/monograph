@prefix mono: <https://example.org/monograph/ontology#> .
@prefix shape: <https://example.org/monograph/shapes#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/monograph/ontology>
    a owl:Ontology ;
    owl:versionIRI <https://example.org/monograph/ontology/2.0.0> ;
    owl:versionInfo "2.0.0" ;
    rdfs:label "MONOGRAPH drug product model" .

mono:AdverseEventReport
    a owl:Class ;
    rdfs:comment "A safety report from FDA adverse event data (FAERS, now FDA AEMS), via openFDA." ;
    rdfs:label "Adverse event report" ;
    rdfs:subClassOf mono:Entity .

mono:ClinicalDrug
    a owl:Class ;
    rdfs:comment "A clinical drug concept in RxNorm, identified by its RxCUI. Several NDC products can share one clinical drug. The name is optional because openFDA carries RxCUIs without their RxNorm names." ;
    rdfs:label "Clinical drug" ;
    rdfs:subClassOf mono:Entity .

mono:DrugInvolvement
    a owl:Class ;
    rdfs:comment "A drug mentioned in an adverse event report, as reported." ;
    rdfs:label "Drug involvement" ;
    rdfs:subClassOf mono:EmbeddedValue .

mono:DrugRole
    a owl:Class ;
    rdfs:comment "The role a drug played in an adverse event report. `suspect` is E2B characterization 1 when the source does not say which suspect is primary." ;
    rdfs:label "Drug role" .

mono:DrugRole-CONCOMITANT
    a mono:DrugRole, owl:NamedIndividual ;
    rdfs:label "concomitant" .

mono:DrugRole-INTERACTING
    a mono:DrugRole, owl:NamedIndividual ;
    rdfs:label "interacting" .

mono:DrugRole-PRIMARY_SUSPECT
    a mono:DrugRole, owl:NamedIndividual ;
    rdfs:label "primary suspect" .

mono:DrugRole-SECONDARY_SUSPECT
    a mono:DrugRole, owl:NamedIndividual ;
    rdfs:label "secondary suspect" .

mono:DrugRole-SUSPECT
    a mono:DrugRole, owl:NamedIndividual ;
    rdfs:label "suspect" .

mono:EmbeddedValue
    a owl:Class ;
    rdfs:comment "A value that only exists inside its parent entity. Its IRI derives from the parent's IRI." ;
    rdfs:label "Embedded value" .

mono:Entity
    a owl:Class ;
    rdfs:comment "A thing with a public identifier and its own IRI." ;
    rdfs:label "Entity" .

mono:Ingredient
    a owl:Class ;
    rdfs:comment "An active ingredient of a product with its strength." ;
    rdfs:label "Ingredient" ;
    rdfs:subClassOf mono:EmbeddedValue .

mono:Label
    a owl:Class ;
    rdfs:comment "One version of a structured product label (SPL)." ;
    rdfs:label "Label" ;
    rdfs:subClassOf mono:Entity .

mono:LabelSection
    a owl:Class ;
    rdfs:comment "One LOINC-coded section of a structured product label." ;
    rdfs:label "Label section" ;
    rdfs:subClassOf mono:EmbeddedValue .

mono:Organization
    a owl:Class ;
    rdfs:comment "A company acting as manufacturer, labeler or recalling firm." ;
    rdfs:label "Organization" ;
    rdfs:subClassOf mono:Entity .

mono:PackagedProduct
    a owl:Class ;
    rdfs:comment "A package of a product, identified by its 10-digit hyphenated package NDC." ;
    rdfs:label "Packaged product" ;
    rdfs:subClassOf mono:Entity .

mono:Product
    a owl:Class ;
    rdfs:comment "A drug product as listed with FDA, identified by its product NDC (labeler and product segments)." ;
    rdfs:label "Product" ;
    rdfs:subClassOf mono:Entity .

mono:ProductType
    a owl:Class ;
    rdfs:comment "The FDA NDC directory product type." ;
    rdfs:label "Product type" .

mono:ProductType-BULK_INGREDIENT
    a mono:ProductType, owl:NamedIndividual ;
    rdfs:label "BULK INGREDIENT" .

mono:ProductType-CELLULAR_THERAPY
    a mono:ProductType, owl:NamedIndividual ;
    rdfs:label "CELLULAR THERAPY" .

mono:ProductType-DRUG_FOR_FURTHER_PROCESSING
    a mono:ProductType, owl:NamedIndividual ;
    rdfs:label "DRUG FOR FURTHER PROCESSING" .

mono:ProductType-HUMAN_OTC_DRUG
    a mono:ProductType, owl:NamedIndividual ;
    rdfs:label "HUMAN OTC DRUG" .

mono:ProductType-HUMAN_PRESCRIPTION_DRUG
    a mono:ProductType, owl:NamedIndividual ;
    rdfs:label "HUMAN PRESCRIPTION DRUG" .

mono:ProductType-LICENSED_VACCINE_BULK_INTERMEDIATE
    a mono:ProductType, owl:NamedIndividual ;
    rdfs:label "LICENSED VACCINE BULK INTERMEDIATE" .

mono:ProductType-NON_STANDARDIZED_ALLERGENIC
    a mono:ProductType, owl:NamedIndividual ;
    rdfs:label "NON-STANDARDIZED ALLERGENIC" .

mono:ProductType-PLASMA_DERIVATIVE
    a mono:ProductType, owl:NamedIndividual ;
    rdfs:label "PLASMA DERIVATIVE" .

mono:ProductType-STANDARDIZED_ALLERGENIC
    a mono:ProductType, owl:NamedIndividual ;
    rdfs:label "STANDARDIZED ALLERGENIC" .

mono:ProductType-VACCINE
    a mono:ProductType, owl:NamedIndividual ;
    rdfs:label "VACCINE" .

mono:Reaction
    a owl:Class ;
    rdfs:comment "A reaction, as a MedDRA preferred term string. No MedDRA hierarchy is shipped (licensed)." ;
    rdfs:label "Reaction" ;
    rdfs:subClassOf mono:EmbeddedValue .

mono:Recall
    a owl:Class ;
    rdfs:comment "A drug recall from the FDA enforcement report." ;
    rdfs:label "Recall" ;
    rdfs:subClassOf mono:Entity .

mono:RecallClassification
    a owl:Class ;
    rdfs:comment "FDA recall classification, from I (most serious) to III." ;
    rdfs:label "Recall classification" .

mono:RecallClassification-CLASS_I
    a mono:RecallClassification, owl:NamedIndividual ;
    rdfs:label "I" .

mono:RecallClassification-CLASS_II
    a mono:RecallClassification, owl:NamedIndividual ;
    rdfs:label "II" .

mono:RecallClassification-CLASS_III
    a mono:RecallClassification, owl:NamedIndividual ;
    rdfs:label "III" .

mono:Route
    a owl:Class ;
    rdfs:comment "Route of administration: the FDA SPL route of administration terms, with NCI Thesaurus codes. Source: https://www.fda.gov/industry/structured-product-labeling-resources/route-administration (content current as of 10/29/2021; NCI concept C38114). 121 terms." ;
    rdfs:label "Route of administration" .

mono:Route-AURICULAR_OTIC
    a mono:Route, owl:NamedIndividual ;
    rdfs:label "AURICULAR (OTIC)" .

mono:Route-BUCCAL
    a mono:Route, owl:NamedIndividual ;
    rdfs:label "BUCCAL" .

mono:Route-CONJUNCTIVAL
    a mono:Route, owl:NamedIndividual ;
    rdfs:label "CONJUNCTIVAL" .

mono:Route-CUTANEOUS
    a mono:Route, owl:NamedIndividual ;
    rdfs:label "CUTANEOUS" .

mono:Route-DENTAL
    a mono:Route, owl:NamedIndividual ;
    rdfs:label "DENTAL" .

mono:Route-ELECTRO_OSMOSIS
    a mono:Route, owl:NamedIndividual ;
